# syntax=docker/dockerfile:1
FROM python:3.13-slim

# Install system dependencies required for Sphinx and the docsy build toolchain
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    graphviz \
    curl \
    make \
    && rm -rf /var/lib/apt/lists/*

# Install uv package manager
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

WORKDIR /app

# Copy the repository (including .git history)
COPY . /app

# Sync dependencies and build the static HTML documentation
RUN uv sync
RUN uv run make -C docs html

WORKDIR /app/docs/build/html
EXPOSE 8000
CMD ["python", "-m", "http.server", "8000"]
